---
// src/components/Footer.astro
---

<footer class="bg-vino-600 text-white pt-12 pb-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        
        <div >
            <div class="w-40 mb-3"> <!-- Ajusta el ancho según necesites -->
                <a href="/">
                  <img 
                    src="/logo-white.svg" 
                    alt="GRUPO CLAVESECUROS" 
                    class="w-full h-auto" 
                  />
                </a>
              </div>
          <p class="text-white mb-4">Experiencia y Solidez.</p>
          <div class="flex items-center">
            <svg class="w-5 h-5 text-white mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="text-white">info@claveseguros.com</span>
            
          </div>
        </div>
        <div>
          <h3 class="text-lg font-semibold mb-4">Teléfono</h3>
          <ul class="space-y-2">
            <li><span class="text-white hover:text-white transition-colors">Quito: 02-399-6100</span></li>
            <li><span class="text-white hover:text-white transition-colors">Guayaquil: 04-210-7244</span></li>
          </ul>
        </div>
        
        {/* Columnas de enlaces */}
        <div>
          <h3 class="text-lg font-semibold mb-4">Horarios</h3>
          <ul class="space-y-2">
            <li><span class="text-white hover:text-white transition-colors">Lunes a Jueves</span></li>
            <li><span class="text-white hover:text-white transition-colors">de 09:00 a 18:00</span></li>
            <li><span class="text-white hover:text-white transition-colors">Viernes</span></li>
            <li><span class="text-white hover:text-white transition-colors">de 09:00 a 16:00</span></li>
          </ul>
          
        </div>
  
        <div>
          <h3 class="text-lg font-semibold mb-4">Dirección</h3>
          <ul class="space-y-2">
            <li><span class="text-white hover:text-white transition-colors">Matriz:</span></li>
            <li>
              <span class="text-white hover:text-white transition-colors">Av. Amazonas N35-43 y Juan Pablo Sans</span><br>
              <span class="text-white hover:text-white transition-colors">Edf. Antisana 4to p.</span><br>
            </li>
            <li><span class="text-white hover:text-white transition-colors">Guayaquil:</span></li>
            <li>
              <span class="text-white hover:text-white transition-colors">Av. Juan Tanca Marengo Km 1.5</span><br>
              <span class="text-white hover:text-white transition-colors">Edf. Profesional Center Of.207</span><br>
            </li>
          </ul>
        </div>
      </div>
  
      {/* Divider */}
      <div class="border-t border-gray-800 my-6"></div>
  
      {/* Footer inferior */}
      <div class="flex flex-col md:flex-row justify-between items-center">
        <div class="mb-4 md:mb-0">
          <span class="text-white text-sm">© CODEC.EC. Todos los derechos reservados.</span>
        </div>
        <div class="flex space-x-6">
          
        </div>
      </div>
    </div>
  </footer>