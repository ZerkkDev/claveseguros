---
// Importa las imágenes
const partners = [
  { name: "Seguros Equinoccial", logo: "/src/assets/partners/1.png" },
  { name: "Confiamed", logo: "/src/assets/partners/2.png" },
  { name: "Saludsa", logo: "/src/assets/partners/3.png" },
  { name: "Humana", logo: "/src/assets/partners/4.png" },
  { name: "Zurich", logo: "/src/assets/partners/5.png" },

];
---

<section class="bg-white mx-3 py-2">
  <h2 class="text-center text-xl font-semibold mb-6">Socios Comerciales</h2>

  <div class="relative overflow-hidden px-6 mx-20 bg-grey-950 rounded-lg ">
    <!-- Botón izquierdo -->
    <button id="prevBtn" class="absolute left-0 top-1/2 -translate-y-1/2 z-10 bg-white border-2 py-1 px-2 rounded-full hover:bg-gray-100 transition border-dark-900">
      ←
    </button>

    <!-- Contenedor deslizable ajustado para 5 logos -->
    <div id="slider" class="flex gap-4 overflow-x-auto scroll-smooth no-scrollbar">
      {partners.map(partner => (
        <div class="flex-shrink-0 w-[calc(20%-16px)] flex justify-center items-center p-4">
          <img 
            src={partner.logo} 
            alt={partner.name} 
            class="max-h-30 w-auto object-contain" 
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <!-- Botón derecho -->
    <button id="nextBtn" class="absolute right-0 top-1/2 -translate-y-1/2 z-10 bg-white py-1 px-2 rounded-full hover:bg-gray-100 transition border-dark-900 border-2">
      →
    </button>
  </div>
</section>

<script type="module" is:inline>
  const slider = document.getElementById('slider');
  const nextBtn = document.getElementById('nextBtn');
  const prevBtn = document.getElementById('prevBtn');

  nextBtn.addEventListener('click', () => {
    slider.scrollBy({ left: 300, behavior: 'smooth' });
  });

  prevBtn.addEventListener('click', () => {
    slider.scrollBy({ left: -300, behavior: 'smooth' });
  });
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>