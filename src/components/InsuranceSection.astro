---
// src/components/InsuranceSection.astro
---
<section class="py-16 bg-white" id="seguros">
    <div class="container mx-auto px-4 max-w-9xl">
      <!-- Título principal -->
      <h2 class="text-4xl font-bold text-black text-left">Seguros</h2>
      <hr class="w-16 h-1 bg-vino-600 border-0 mt-2 mb-12">
      <!-- Grid de categorías -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Tarjeta Personas -->
        <div class="bg-gray-200 rounded-b-xl shadow-sm hover:shadow-md transition duration-300">
          <img class="mb-3 w-200 h-200" src="/src/assets/seguros/1.png" alt="">
          <h3 class="text-xl px-3 font-medium mb-4">Personas</h3>
          <p class="text-gray-600 px-3 pb-3">
            Productos que brindan protección económica ante riesgos relacionados con la salud, accidentes, vida o incapacidades.
          </p>
        </div>
  
        <!-- Tarjeta Empresas -->
        <div class="bg-gray-200 rounded-b-xl shadow-sm hover:shadow-md transition duration-300">
            <img class="mb-3 w-200 h-200" src="/src/assets/seguros/2.png" alt="">
            <h3 class="text-xl px-3 font-medium mb-4">Empresas</h3>
            <p class="text-gray-600 px-3 pb-3">
                Pólizas diseñadas para proteger a las organizaciones contra todos sus riesgos e imprevistos negativos.
            </p>
        </div>
  
        <!-- Tarjeta Vehículos -->
        <div class="bg-gray-200 rounded-b-xl shadow-sm hover:shadow-md transition duration-300500">
            <img class="mb-3 w-50 h-200" src="/src/assets/seguros/3.png" alt="">
          <h3 class="text-xl px-3 font-medium mb-4">Vehículos</h3>
          <p class="text-gray-600 px-3 pb-3">
            Productos que cubren los daños y pérdidas ocasionados a un automóvil o a terceros.
          </p>
        </div>
  
        <!-- Tarjeta Masivos -->
        <div class="bg-gray-200 rounded-b-xl shadow-sm hover:shadow-md transition duration-3000">
            <img class="mb-3 w-200 h-200" src="/src/assets/seguros/4.png" alt="">
          <h3 class="text-xl px-3 font-medium mb-4">Masivos</h3>
          <p class="text-gray-600 px-3 pb-3">
            Soluciones de seguros de bajo impacto financiero y alta penetración y flotación.
          </p>
        </div>
      </div>
    </div>
  </section>