---
// src/components/ExperienceSection.astro
---
<section class="relative py-40 bg-cover bg-center bg-no-repeat">
    <!-- Fondo con overlay oscuro para mejor legibilidad -->
    <div class="absolute inset-0  z-0"></div>
    
    <!-- Contenido (relative para que aparezca sobre el fondo) -->
    <div class="container mx-auto px-2 max-w-4xl relative z-10 text-white">
      <!-- Título principal -->
      <div class="mb-8">
        <h2 class="text-7xl font-bold mb-2 text-vino-600 font-montserrat">51 años</h2>
        <p class="text-4xl text-black opacity-90 font-semibold font-poppins">de experiencia y solidez</p>
      </div>
  
      <!-- Descripción -->
      <div class="mb-10 max-w-lg">
        <p class="text-lg text-black leading-relaxed opacity-90 font-poppins">
          Nuestro enfoque <strong class="font-semibold">personalizado</strong> y a la <strong class="font-semibold">medida</strong>, nos convierten en tu mejor aliado estratégico en seguros.
        </p>
      </div>
  
      <!-- Botón -->
      <a href="#" class="inline-block bg-vino-600 hover:bg-vino-700 text-white font-medium py-3 px-8 rounded-3xl transition duration-300">
        Más información
      </a>
    </div>
  
    <!-- Estilo inline para la imagen de fondo -->
    <style>
      section {
        background-image: url('/img/slider-bg.png'); /* Ruta a tu imagen */
      }
    </style>
  </section>