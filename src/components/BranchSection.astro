---
// src/components/BranchSection.astro
---
<section class="relative py-16 bg-cover bg-center" id="hability-branchs">
  <!-- Overlay -->
  <div class="absolute inset-0 bg-vino-600/80"></div>


  <!-- Contenido -->
  <div class="relative max-w-6xl mx-auto px-6 text-white z-10">
    <h2 class="text-4xl font-bold text-white text-left">Ramos Habilitados</h2>
    <hr class="w-16 h-1 bg-white border-0 mt-2 mb-12">

    <div class="grid md:grid-cols-2 gap-8 text-lg font-normal">
      <ul class="space-y-4">
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Incendio', 'Cubre pérdidas o daños causados por fuego, explosiones, humo y fenómenos relacionados que afecten bienes asegurados, como edificaciones, inventarios y mobiliario. Además, puede incluir coberturas adicionales contra riesgos como daños por agua, caída de rayo, terremotos y varias adicionales, según lo pactado en la póliza.')"><img src="/icons/fire.svg" class="w-5 h-auto" alt="" > Incendio</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Robo', 'Protege los bienes asegurados contra la sustracción ilegal mediante actos violentos o intimidatorios, incluyendo daños materiales ocasionados durante el delito. Esta cobertura puede extenderse a hurtos, vandalismo y pérdida de mercancías, según las condiciones específicas de la póliza.')"><img src="/icons/theft.svg" class="w-5 h-auto" alt=""> Robo</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Equipo Electrónico', 'Cubre daños, pérdidas o mal funcionamiento de equipos electrónicos y tecnológicos como computadoras, servidores, equipos médicos y maquinaria especializada, causados por accidentes, fallas eléctricas, incendios, robos o fenómenos naturales. Esta cobertura garantiza la reparación, reposición o indemnización del equipo asegurado para minimizar interrupciones en la operación del asegurado.')"><img src="/icons/thunder.svg" class="w-5 h-auto" alt=""> Equipo Electrónico</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Vehículos', 'Cubre daños materiales y responsabilidad civil derivados de accidentes de tránsito, robo o daños a terceros. Puede incluir coberturas como colisión, incendio, daños por fenómenos naturales y asistencia vial, protegiendo tanto al conductor como a terceros involucrados.')"><img src="/icons/car.svg" class="w-5 h-auto" alt=""> Vehículos</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Transporte Interno', 'Protege las mercancías transportadas contra pérdidas o daños ocasionados durante su traslado dentro de Ecuador, ya sea por vía terrestre, fluvial o lacustre. Esta cobertura usualmente incluye riesgos como accidentes, robo, incendio y eventos de la naturaleza que afecten la carga durante el trayecto.')"><img src="/icons/bus.svg" class="w-5 h-auto" alt=""> Transporte Interno</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Transporte de Importación', 'Ampara las mercancías desde su punto de origen en el extranjero hasta su destino final en Ecuador, incluyendo tránsito marítimo, aéreo o terrestre. Protege contra riesgos como pérdida, daño, robo, incendio y otros eventos imprevistos ocurridos durante el transporte internacional.')"><img src="/icons/container.svg" class="w-5 h-auto" alt=""> Transporte de Importación</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Cumplimiento Contrato', 'Garantiza que el contratista o proveedor cumpla con las obligaciones pactadas en un contrato, ya sea de obra, suministro o servicio. En caso de incumplimiento, la aseguradora indemniza al beneficiario por los perjuicios económicos sufridos, hasta el límite asegurado')"><img src="/icons/contract-management.svg" class="w-5 h-auto" alt=""> Cumplimiento Contrato</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Buen Uso Anticipo', 'Garantiza que los recursos entregados por adelantado al contratista o proveedor sean utilizados exclusivamente para la ejecución del contrato. Si el anticipo es mal utilizado o no se justifica conforme a lo pactado, la aseguradora indemniza al beneficiario por el monto no respaldado o mal empleado.')"><img src="/icons/cash-advance.svg" class="w-5 h-auto" alt=""> Buen Uso Anticipo</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Lucro Cesante', '<p>Indemniza a las empresas por las ganancias que dejan de percibir debido a la interrupción de su actividad comercial, generalmente como consecuencia de un siniestro cubierto, como un incendio o la rotura de maquinaria.</p> <br> <p>Este seguro se considera una extensión de las pólizas de incendio o rotura de maquinaria y puede incluir coberturas adicionales como honorarios de auditores, gastos de viaje y estadía, y pérdidas económicas derivadas de la interrupción de proveedores o distribuidores.</p>')"><img src="/icons/coins-bag.svg" class="w-5 h-auto" alt=""> Lucro Cesante</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Seguro de Credito Interno', 'Protege a las empresas frente al riesgo de incumplimiento de pago por parte de sus clientes nacionales, asegurando la recuperación de facturas o créditos otorgados. Esta cobertura ayuda a mantener la estabilidad financiera del asegurado ante impagos por insolvencia, morosidad o quiebra de los compradores dentro del país.')"><img src="/icons/credit-shield.svg" class="w-5 h-auto" alt=""> Seguro de Credito Interno</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Seriedad Oferta', 'Respalda al oferente durante un proceso de licitación, garantizando que mantendrá su propuesta y, en caso de ser adjudicado, firmará el contrato y entregará las garantías requeridas. Si el oferente incumple estas condiciones, la aseguradora indemniza al convocante por los perjuicios ocasionados.')"><img src="/icons/contract-handshake.svg" class="w-5 h-auto" alt=""> Seriedad Oferta</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Responsabilidad Civil', 'Protege al asegurado frente a reclamaciones legales por daños a terceros, ya sean personales, materiales o patrimoniales, causados por acciones u omisiones propias o de sus empleados. La aseguradora se encarga de pagar indemnizaciones, gastos legales y otros costos derivados de dichas reclamaciones, hasta el límite establecido en la póliza.')"><img src="/icons/people.svg" class="w-5 h-auto" alt=""> Responsabilidad Civil</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Rotura de Maquinaria', 'Proteger a las empresas contra daños súbitos e imprevistos que afecten a maquinarias fijas o estacionarias, como generadores, calderas, ascensores y líneas de producción. Este seguro cubre riesgos tales como impericia, errores de diseño, fallas eléctricas, entrada de cuerpos extraños, y otros eventos inesperados que puedan interrumpir la operación normal de la maquinaria asegurada.')"><img src="/icons/machine-broker.svg" class="w-5 h-auto" alt=""> Rotura de Maquinaria</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Equipo & Maquinaria', 'Diseñado para proteger a las empresas frente a daños o pérdidas accidentales de sus activos productivos, como maquinaria pesada, equipos móviles y herramientas especializadas. Este tipo de póliza es esencial para sectores como la construcción, minería, agricultura e industria, donde la operación continua de equipos es crucial para la productividad.')"><img src="/icons/wash-machine.svg" class="w-5 h-auto" alt=""> Equipo & Maquinaria</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Todo Riesgo Montaje', 'Diseñada para proteger a las empresas durante la instalación o montaje de maquinaria, equipos industriales y estructuras metálicas. Cubre daños imprevistos y accidentales que puedan ocurrir en el sitio de la obra, desde la descarga de los bienes hasta su puesta en marcha')"><img src="/icons/warning.svg" class="w-5 h-auto" alt=""> Todo Riesgo Montaje</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Todo Riesgo Construcción', 'Póliza diseñada para proteger a los contratistas, empresas constructoras e inversionistas durante la ejecución de obras civiles, abarcando desde la construcción de edificios hasta proyectos de ingeniería civil como puentes y carreteras. Esta cobertura ofrece protección integral frente a daños materiales, pérdidas accidentales y responsabilidades civiles derivadas de la obra.')"><img src="/icons/broke-house.svg" class="w-5 h-auto" alt=""> Todo Riesgo Construcción</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Debida Ejecución de Obra Y Buena Calidad de Materiales', 'Garantiza que el contratista realizará la obra conforme a los planos, especificaciones técnicas y plazos establecidos, utilizando materiales de calidad adecuada. Si durante el plazo de garantía se detectan defectos en la ejecución o en los materiales, la aseguradora responde por los daños hasta el límite asegurado.')"><img src="/icons/construction.svg" class="w-5 h-auto" alt=""> Debida Ejecución de Obra Y Buena Calidad de Materiales </li>
        <!-- Agrega más ítems... -->
      </ul>
      <ul class="space-y-4">
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Casco Aéreo y Marítimo', 'Ofrecen coberturas especializadas para aeronaves y embarcaciones, respectivamente, protegiendo tanto a las naves como a sus ocupantes y terceros involucrados.')"><img src="/icons/boat.svg" class="w-5 h-auto" alt=""> Casco Aéreo y Marítimo</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Casco Marítimo', 'Protege a embarcaciones y buques contra daños físicos o pérdidas ocasionadas por accidentes, naufragios, colisiones, incendios y otros riesgos marítimos durante la navegación o en puerto. Incluye reparaciones, reconstrucción o indemnización del valor asegurado según el tipo y alcance del siniestro.')"><img src="/icons/cargo-ship.svg" class="w-5 h-auto" alt=""> Casco Marítimo</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Directores y Administradores', 'Protege a los miembros del directorio, gerentes y administradores de una empresa frente a reclamaciones por daños y perjuicios derivados de decisiones u omisiones en el ejercicio de sus funciones. Cubre costos legales, indemnizaciones y gastos relacionados con demandas por negligencia, errores, omisiones o actos indebidos en la gestión empresarial.')"><img src="/icons/person-badge.svg" class="w-5 h-auto" alt=""> Directores y Administradores</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Garantía Aduanera', 'Asegura el cumplimiento de obligaciones tributarias y aduaneras relacionadas con operaciones de importación, exportación o tránsito de mercancías ante la autoridad aduanera. Si el importador o responsable no cumple con dichos compromisos, la aseguradora responde por los tributos, multas e intereses exigidos por el Servicio Nacional de Aduana del Ecuador (SENAE).')"><img src="/icons/package-box.svg" class="w-5 h-auto" alt=""> Garantía Aduanera</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Fianzas', 'Garantiza el cumplimiento de obligaciones establecidas por disposiciones legales o reglamentarias, cuando la ley exige una garantía para el ejercicio de ciertas actividades o derechos. La aseguradora responde ante la autoridad correspondiente si el afianzado incumple con dichas obligaciones legales.')"><img src="/icons/pig-coins.svg" class="w-5 h-auto" alt=""> Fianzas</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Crimen', 'Diseñado para proteger a las empresas contra pérdidas financieras derivadas de actos fraudulentos, ya sean cometidos por empleados o terceros. Este tipo de póliza es esencial para mitigar riesgos asociados con delitos financieros que pueden comprometer la estabilidad económica de una organización.')"><img src="/icons/thief.svg" class="w-5 h-auto" alt=""> Crimen</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Cyber', 'Diseñado para proteger tanto a individuos como a empresas frente a riesgos cibernéticos, como ataques informáticos, fraudes en línea y pérdida de datos. Estas pólizas ofrecen asistencia especializada, cobertura financiera y servicios de respuesta ante incidentes digitales')"><img src="/icons/cyber.svg" class="w-5 h-auto" alt=""> Cyber</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Agrícola', 'Protege las cosechas y cultivos frente a riesgos climáticos, plagas, enfermedades y otros eventos que puedan causar pérdidas o daños a la producción agrícola. Su objetivo es garantizar la estabilidad económica del agricultor y fomentar la continuidad de la actividad productiva.')"><img src="/icons/eco.svg" class="w-5 h-auto" alt=""> Agrícola</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Seguro Ganadero', 'Cubre la pérdida o muerte de animales asegurados debido a riesgos como enfermedades, accidentes, eventos climáticos extremos o ataques de depredadores. Está diseñado para proteger la inversión del productor pecuario y fomentar la estabilidad económica en el sector ganadero.')"><img src="/icons/cow.svg" class="w-5 h-auto" alt=""> Seguro Ganadero</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Seguro Equino', 'Protege a los caballos contra riesgos como muerte, accidentes, enfermedades o robo, garantizando la indemnización al propietario en caso de siniestro. Esta póliza está dirigida a propietarios de caballos de competencia, trabajo o reproducción, asegurando su inversión y bienestar animal.')"><img src="/icons/horse.svg" class="w-5 h-auto" alt=""> Seguro Equino</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Fidelidad', 'Protege a las empresas contra pérdidas financieras ocasionadas por actos deshonestos o fraudulentos cometidos por sus empleados, como robo, apropiación indebida o malversación de fondos. Esta póliza cubre tanto el daño patrimonial directo como los gastos derivados de la investigación y recuperación de los fondos afectados.')"><img src="/icons/badge.svg" class="w-5 h-auto" alt=""> Fidelidad</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Vida', 'Protege a los beneficiarios designados mediante el pago de un capital asegurado en caso de fallecimiento del asegurado, ofreciendo además opciones adicionales como cobertura por invalidez, enfermedades graves y ahorro o inversión a largo plazo. Este seguro brinda tranquilidad financiera a la familia y garantiza soporte económico frente a imprevistos.')"><img src="/icons/heart.svg" class="w-5 h-auto" alt=""> Vida</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Asistencia Médica', 'Ofrece cobertura para gastos médicos derivados de accidentes o enfermedades, tanto ambulatorios como hospitalarios, con opciones que incluyen servicios de telemedicina, consultas médicas, medicamentos, odontología y atención domiciliaria. Dependiendo del plan, también pueden incluirse coberturas para emergencias, traslados en ambulancia, repatriación sanitaria y servicios exequiales.')"><img src="/icons/doctor.svg" class="w-5 h-auto" alt=""> Asistencia Médica</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Accidentes Personales', 'Brinda cobertura económica ante lesiones, invalidez o fallecimiento ocasionados por accidentes imprevistos, ofreciendo indemnizaciones según la gravedad del daño sufrido. Protege al asegurado o a sus beneficiarios frente a eventos que afecten su integridad física fuera del ámbito laboral.')"><img src="/icons/crash.svg" class="w-5 h-auto" alt=""> Accidentes Personales</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Garantía Judicial', 'Respalda el cumplimiento de obligaciones procesales o el pago de posibles condenas económicas dentro de un proceso judicial, conforme lo ordene una autoridad competente. Esta garantía sustituye el depósito en efectivo u otra forma de caución exigida por el juez, asegurando que el asegurado responderá en caso de una sentencia desfavorable.')"><img src="/icons/judge.svg" class="w-5 h-auto" alt=""> Garantía Judicial</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Desgravamen', 'Cubre el saldo pendiente de un crédito o préstamo en caso de fallecimiento, invalidez total o permanente del asegurado, garantizando que la deuda quede saldada y no afecte económicamente a sus familiares o herederos. Es comúnmente utilizado para proteger créditos hipotecarios, personales o automotrices.')"><img src="/icons/shield.svg" class="w-5 h-auto" alt=""> Desgravamen</li>
        <li class="flex items-center gap-3 cursor-pointer transition hover:text-blue-400" onclick="showModal('Viajes', 'Protección integral para los viajeros, cubriendo desde gastos médicos por accidentes o enfermedades hasta imprevistos como pérdida de equipaje, cancelaciones de vuelos y asistencia legal. Es esencial para quienes viajan al extranjero, ya que muchos países requieren este seguro para ingresar, y brinda tranquilidad ante posibles emergencias.')"><img src="/icons/plain.svg" class="w-5 h-auto" alt=""> Viajes</li>
        <!-- ... -->
      </ul>
    </div>
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-primary/80 via-primary/90 to-primary/80 mix-blend-multiply"></div>
  <style>
    section {
      background-image: url('/img/bg-branchs.jpg');
    }
  </style>
  <!-- Modal de Tailwind CSS -->
  <div id="branchModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <!-- Fondo oscuro -->
      <div class="fixed inset-0 transition-opacity" aria-hidden="true">
        <div class="absolute inset-0 bg-gray-500 opacity-75"></div>
      </div>

      <!-- Contenido del modal -->
      <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
          <div class="sm:flex sm:items-start">
            <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
              <div class="flex justify-between items-center">
                <h3 id="modalTitle" class="text-2xl leading-6 font-bold text-vino-600"></h3>
                <button onclick="hideModal()" class="text-gray-400 hover:text-gray-500">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
              <hr class="my-3 border-vino-300">
              <div class="mt-2">
                <p id="modalContent" class="text-gray-700"></p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
          <button type="button" onclick="hideModal()" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-vino-600 text-base font-medium text-white hover:bg-vino-700 focus:outline-none sm:ml-3 sm:w-auto sm:text-sm">
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute inset-0 bg-gradient-to-r from-primary/80 via-primary/90 to-primary/80 mix-blend-multiply"></div>
  
  <style>
    section {
      background-image: url('/img/bg-branchs.jpg');
    }
  </style>

  <script is:inline>
    // Datos de los ramos (puedes mover esto a un archivo JSON si prefieres)
    const branchData = {
      'Incendio': {
        description: 'Protección contra daños materiales causados por incendio, explosión o caída de rayo. Cobertura amplia para propiedades comerciales e industriales.',
        details: 'Incluye daños directos por fuego, humo y los gastos de extinción. Opcionalmente puede cubrir daños por explosión y caída de rayo.'
      },
      'Robo': {
        description: 'Cobertura por pérdidas derivadas de robos con fuerza, incluyendo daños a la propiedad durante el evento.',
        details: 'Protección para inventarios, equipos y bienes. Cubre el hurto con violencia o fuerza en las cosas.'
      }
      // Agrega todos los demás ramos aquí...
    };

    // Mostrar modal con información
    function showModal(title, description) {
      const modal = document.getElementById('branchModal');
      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalContent').innerHTML = description;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    // Ocultar modal
    function hideModal() {
      const modal = document.getElementById('branchModal');
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    // Cerrar modal al hacer clic fuera del contenido
    document.getElementById('branchModal').addEventListener('click', function(e) {
      if (e.target === this) {
        hideModal();
      }
    });

    // Cerrar con tecla ESC
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        hideModal();
      }
    });
  </script>
</section>
