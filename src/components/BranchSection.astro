  <div class="absolute inset-0 bg-gradient-to-r from-primary/80 via-primary/90 to-primary/80 mix-blend-multiply"></div>
  <style>
    section {
      background-image: url('/img/bg-branchs.jpg');
    }
  </style>
  <!-- Modal de Tailwind CSS -->
  <div id="branchModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <!-- Fondo oscuro -->
      <div class="fixed inset-0 transition-opacity" aria-hidden="true">
        <div class="absolute inset-0 bg-gray-500 opacity-75"></div>
      </div>

      <!-- Contenido del modal -->
      <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
          <div class="sm:flex sm:items-start">
            <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
              <div class="flex justify-between items-center">
                <h3 id="modalTitle" class="text-2xl leading-6 font-bold text-vino-600"></h3>
                <button onclick="hideModal()" class="text-gray-400 hover:text-gray-500">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
              <hr class="my-3 border-vino-300">
              <div class="mt-2">
                <p id="modalContent" class="text-gray-700"></p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
          <button type="button" onclick="hideModal()" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-vino-600 text-base font-medium text-white hover:bg-vino-700 focus:outline-none sm:ml-3 sm:w-auto sm:text-sm">
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute inset-0 bg-gradient-to-r from-primary/80 via-primary/90 to-primary/80 mix-blend-multiply"></div>
  
  <style>
    section {
      background-image: url('/img/bg-branchs.jpg');
    }
  </style>

  <script is:inline>
    // Datos de los ramos (puedes mover esto a un archivo JSON si prefieres)
    const branchData = {
      'Incendio': {
        description: 'Protección contra daños materiales causados por incendio, explosión o caída de rayo. Cobertura amplia para propiedades comerciales e industriales.',
        details: 'Incluye daños directos por fuego, humo y los gastos de extinción. Opcionalmente puede cubrir daños por explosión y caída de rayo.'
      },
      'Robo': {
        description: 'Cobertura por pérdidas derivadas de robos con fuerza, incluyendo daños a la propiedad durante el evento.',
        details: 'Protección para inventarios, equipos y bienes. Cubre el hurto con violencia o fuerza en las cosas.'
      }
      // Agrega todos los demás ramos aquí...
    };

    // Mostrar modal con información
    function showModal(title, description) {
      const modal = document.getElementById('branchModal');
      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalContent').textContent = description;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    // Ocultar modal
    function hideModal() {
      const modal = document.getElementById('branchModal');
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    // Cerrar modal al hacer clic fuera del contenido
    document.getElementById('branchModal').addEventListener('click', function(e) {
      if (e.target === this) {
        hideModal();
      }
    });

    // Cerrar con tecla ESC
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        hideModal();
      }
    });
  </script>
</section>
