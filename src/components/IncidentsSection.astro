---
// No necesitas lógica aquí si solo es estático.
---

<section class="py-12 bg-white" id="accident">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <!-- Título con línea decorativa -->
      <h2 class="text-4xl font-bold text-black text-left">Siniestros</h2>
      <hr class="w-16 h-1 bg-vino-600 border-0 mt-2 mb-12">
  
      <!-- Grid de tarjetas -->
      <div class="grid md:grid-cols-3 gap-6">
        <!-- Tarjeta 1 -->
        <div class="bg-white rounded-b-xl shadow-sm hover:shadow-md transition duration-300">
          <img 
            class="mb-3 object-cover transform transition-transform duration-300 hover:scale-110" 
            src="/seguros/6.png" 
            alt="">
          <h3 class="text-xl px-3 font-medium mb-4">Personas</h3>
          <p class="text-gray-600 px-3 pb-3">
            Someter un reclamo de asistencia médica, vida o accidentes personales.
          </p>
        </div>
  
        <!-- Tarjeta 2 -->
        <div class="bg-white  rounded-b-xl shadow-sm hover:shadow-md transition duration-300">
          <img 
            class="mb-3 object-cover transform transition-transform duration-300 hover:scale-110" 
            src="/seguros/factory-incident.png" 
            alt="">
          <h3 class="text-xl px-3 font-medium mb-4">Empresas</h3>
          <p class="text-gray-600 px-3 pb-3">
            Contáctanos a nuestro Departamento Técnico.
          </p>
        </div>

        <!-- Tarjeta 3 -->
        <div class="bg-white rounded-b-xl shadow-sm hover:shadow-md transition duration-300">
          <img 
            class="mb-3  object-cover transform transition-transform duration-300 hover:scale-110" 
            src="/seguros/cars-accident.png" 
            alt="">
          <h3 class="text-xl px-3 font-medium mb-4">Vehículos</h3>
          <p class="text-gray-600 px-3 pb-3">
            Someter un siniestro vehicular o de terceros.
          </p>
        </div>

      </div>
    </div>
  </section>

  