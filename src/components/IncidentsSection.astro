---
// No necesitas lógica aquí si solo es estático.
---

<section class="py-12 bg-white">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <!-- Título con línea decorativa -->
      <h2 class="text-4xl font-bold text-black text-left">Siniestros</h2>
      <hr class="w-16 h-1 bg-vino-600 border-0 mt-2 mb-12">
  
      <!-- Grid de tarjetas -->
      <div class="grid md:grid-cols-3 gap-6">
        <!-- Tarjeta 1 -->
        <div class="bg-white rounded-lg shadow p-4">
          <img src="/src/assets/seguros/5.png" alt="Personas" class="rounded-md w-full h-48 object-cover" />
          <h3 class="text-green-900 font-semibold text-lg mt-4">Personas</h3>
          <p class="text-gray-600 text-sm mt-2">
            Someter un reclamo de asistencia médica, vida o accidentes personales.
          </p>
        </div>
  
        <!-- Tarjeta 2 -->
        <div class="bg-white rounded-lg shadow p-4">
          <img src="/src/assets/seguros/6.png" alt="Empresas" class="rounded-md w-full h-48 object-cover" />
          <h3 class="text-green-900 font-semibold text-lg mt-4">Empresas</h3>
          <p class="text-gray-600 text-sm mt-2">
            Contáctanos a nuestro Departamento Técnico.
          </p>
        </div>
  
        <!-- Tarjeta 3 -->
        <div class="bg-white rounded-lg shadow p-4">
          <img src="/src/assets/seguros/7.png" alt="Vehículos" class="rounded-md w-full h-48 object-cover" />
          <h3 class="text-green-900 font-semibold text-lg mt-4">Vehículos</h3>
          <p class="text-gray-600 text-sm mt-2">
            Someter un siniestro vehicular o de terceros.
          </p>
        </div>
      </div>
    </div>
  </section>
  